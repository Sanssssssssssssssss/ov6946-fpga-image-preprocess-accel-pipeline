define_attribute {p:clk25m_i} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:clk25m_i} {PAP_IO_LOC} {P4}
define_attribute {p:clk25m_i} {PAP_IO_VCCIO} {1.5}
define_attribute {p:clk25m_i} {PAP_IO_STANDARD} {LVCMOS15}
define_attribute {p:clk25m_i} {PAP_IO_PULLUP} {TRUE}

create_clock  -name {clk25m_i} [get_ports {clk25m_i}] -period {40} -waveform {0.000 20.000}

create_clock -name {clk74m} {t:pll74m.clkout0} -period {13.468} -waveform {0 6.734}
create_clock -name {clk148m} {t:pll74m.clkout1} -period {6.734} -waveform {0 3.367}
create_clock -name {clk371m} {t:pll74m.clkout2} -period {2.692} -waveform {0 1.346}
create_clock -name {clk742m} {t:pll74m.clkout3} -period {1.346} -waveform {0 0.673}

set_max_delay  {12.000} -from [get_clocks {clk74m}] -to [get_clocks {clk371m}]
set_max_delay  {6.000} -from [get_clocks {clk148m}] -to [get_clocks {clk742m}]


